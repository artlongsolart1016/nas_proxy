# Apache / LiteSpeed configuration for PMES Reverse Proxy
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<FilesMatch "^nas_proxy_config(\.example|\.sample)?\.php$">
    Require all denied
</FilesMatch>
